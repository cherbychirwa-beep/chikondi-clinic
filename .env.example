APP_NAME=ChikondiCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Blantyre

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- XAMPP MySQL / MariaDB (manage with phpMyAdmin) ---
# Create an empty database named "chikondicare" (utf8mb4_unicode_ci) in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chikondicare
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions / security ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Inactivity timeout in minutes (keep <= SESSION_LIFETIME)
CHIKONDI_SESSION_TIMEOUT=30
CHIKONDI_MAX_LOGIN_ATTEMPTS=5
CHIKONDI_LOCKOUT_MINUTES=15

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Printed on receipts and confirmations
CLINIC_ADDRESS="Lilongwe, Malawi"
CLINIC_PHONE="+265 000 000 000"
